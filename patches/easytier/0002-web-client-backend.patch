+/// Runs a config-server client that serves `backend`'s reverse RPC instead of
+/// EasyTier's process-management RPC, so the embedding host decides what a
+/// config server may run. `machine_id` is used as given.
+pub fn run_web_client_with_backend(
+    config_server_url: &str,
+    machine_id: uuid::Uuid,
+    hostname: String,
+    secure_mode: bool,
+    backend: Arc<dyn easytier_core::management::WebClientBackend>,
+) -> Result<easytier_core::management::WebClient<()>> {
+    let endpoint = parse_config_server_endpoint(config_server_url)?;
+    let config = TomlConfigLoader::default();
+    let global_ctx = Arc::new(GlobalCtx::new(config.clone()));
+    let mut flags = global_ctx.get_flags();
+    flags.bind_device = false;
+    config.set_flags(flags.clone());
+    global_ctx.set_flags(flags);
+    let connector = runtime_one_shot_manual_connector(
+        global_ctx,
+        &config,
+        easytier_core::process_runtime::CoreProcessRuntime::new(),
+    )?;
+    Ok(easytier_core::management::WebClient::with_backend(
+        ConfigServerConnector {
+            url: endpoint.connect_url().clone(),
+            connector,
+        },
+        WebClientConfig {
+            token: endpoint.token().to_owned(),
+            machine_id,
+            hostname,
+            device_os: web_client_device_os_info(),
+            easytier_version: EASYTIER_VERSION.to_owned(),
+            secure_mode,
+        },
+        backend,
+    ))
+}
