+/// Heeler: verifies the server's certificate chain and name against the
+/// operating system's trust store, for config-server connections.
+fn get_verifying_tls_client_config() -> Result<rustls::ClientConfig, TunnelError> {
+    init_crypto_provider();
+    let provider = rustls::crypto::CryptoProvider::get_default()
+        .cloned()
+        .ok_or_else(|| TunnelError::InternalError("no TLS crypto provider".to_owned()))?;
+    let verifier = rustls_platform_verifier::Verifier::new(provider.clone())
+        .map_err(|error| TunnelError::InternalError(format!("TLS verifier: {error}")))?;
+    let mut config = rustls::ClientConfig::builder_with_provider(provider)
+        .with_safe_default_protocol_versions()
+        .map_err(|error| TunnelError::InternalError(format!("TLS versions: {error}")))?
+        .dangerous()
+        .with_custom_certificate_verifier(Arc::new(verifier))
+        .with_no_client_auth();
+    config.enable_sni = true;
+    config.enable_early_data = false;
+    Ok(config)
+}
+
