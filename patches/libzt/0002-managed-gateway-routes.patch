+/*
+ * Heeler: lwIP routing hooks for ZeroTier managed routes through a gateway
+ * (a route with a `via`, e.g. a physical LAN behind a member). lwIP itself
+ * only reaches addresses on a netif's own subnet. Both run on lwIP's tcpip
+ * thread with the core locked, so netif_list is stable.
+ *
+ * Every joined network's controller sets its own routes, so one network's
+ * routes must never carry traffic meant for another: a socket bound to a
+ * network's address is routed only through that network, and an unbound one
+ * uses gateway routes only while a single network is up.
+ */
+
+static bool zts_netif4_usable(struct netif* n)
+{
+    return n && n->state && n->name[0] == '4' && netif_is_up(n) && netif_is_link_up(n)
+           && ! ip4_addr_isany_val(*netif_ip4_addr(n));
+}
+
+static bool zts_gateway_route4(struct netif* n, const ip4_addr_t* dest, ip4_addr_t* gw, unsigned int* bits)
+{
+    if (! zts_netif4_usable(n)) {
+        return false;
+    }
+    uint32_t via = 0;
+    if (! ((ZeroTier::VirtualTap*)n->state)->gatewayFor4(ip4_addr_get_u32(dest), &via, bits)) {
+        return false;
+    }
+    ip4_addr_set_u32(gw, via);
+    // The gateway must be reachable on the network itself.
+    return ip4_addr_netcmp(gw, netif_ip4_addr(n), netif_ip4_netmask(n));
+}
+
+// Whether `n` reaches `dest` itself: on its subnet or through one of its
+// own gateway routes.
+static bool zts_netif4_reaches(struct netif* n, const ip4_addr_t* dest)
+{
+    if (! zts_netif4_usable(n)) {
+        return false;
+    }
+    if (ip4_addr_netcmp(dest, netif_ip4_addr(n), netif_ip4_netmask(n))) {
+        return true;
+    }
+    ip4_addr_t gw;
+    unsigned int bits = 0;
+    return zts_gateway_route4(n, dest, &gw, &bits);
+}
+
+extern "C" struct netif* zts_lwip_hook_ip4_route_src(const ip4_addr_t* src, const ip4_addr_t* dest)
+{
+    struct netif* n;
+    if (src && ! ip4_addr_isany(src)) {
+        // Called by ip4_route_src before lwIP's own subnet match: a source
+        // that is a network's address keeps the packet on that network.
+        struct netif* own = NULL;
+        NETIF_FOREACH(n)
+        {
+            if (zts_netif4_usable(n) && ip4_addr_cmp(src, netif_ip4_addr(n))) {
+                own = n;
+                break;
+            }
+        }
+        if (! own) {
+            return NULL;   // Not a ZeroTier address: lwIP's own routing.
+        }
+        if (zts_netif4_reaches(own, dest)) {
+            return own;
+        }
+        // Its network has no route to dest. When another network has one,
+        // the packet still stays on its own (and goes unanswered) rather
+        // than leave through that one; when none has, lwIP reports no
+        // route at once.
+        NETIF_FOREACH(n)
+        {
+            if (n != own && zts_netif4_reaches(n, dest)) {
+                return own;
+            }
+        }
+        return NULL;
+    }
+    // No source (from ip4_route, after lwIP's subnet match failed): a
+    // gateway route is used only while one IPv4 network is up, so no
+    // network's route can take another's traffic.
+    struct netif* only = NULL;
+    NETIF_FOREACH(n)
+    {
+        if (zts_netif4_usable(n)) {
+            if (only) {
+                return NULL;
+            }
+            only = n;
+        }
+    }
+    ip4_addr_t gw;
+    unsigned int bits = 0;
+    return zts_gateway_route4(only, dest, &gw, &bits) ? only : NULL;
+}
+
+extern "C" const ip4_addr_t* zts_lwip_hook_etharp_get_gw(struct netif* n, const ip4_addr_t* dest)
+{
+    static thread_local ip4_addr_t gw;
+    unsigned int bits = 0;
+    return zts_gateway_route4(n, dest, &gw, &bits) ? &gw : NULL;
+}
