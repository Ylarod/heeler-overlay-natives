+void VirtualTap::setGatewayRoutes4(const std::vector<GatewayRoute4>& routes)
+{
+    Mutex::Lock _l(_gatewayRoutes4_m);
+    _gatewayRoutes4 = routes;
+}
+
+bool VirtualTap::gatewayFor4(uint32_t dest, uint32_t* via, unsigned int* bits)
+{
+    Mutex::Lock _l(_gatewayRoutes4_m);
+    bool found = false;
+    for (const GatewayRoute4& route : _gatewayRoutes4) {
+        if ((dest & route.mask) != route.network) {
+            continue;
+        }
+        if (! found || route.bits > *bits) {
+            *via = route.via;
+            *bits = route.bits;
+            found = true;
+        }
+    }
+    return found;
+}
