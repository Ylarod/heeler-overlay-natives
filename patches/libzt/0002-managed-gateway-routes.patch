+    // Heeler: IPv4 routes through a gateway on this network, for lwIP's
+    // routing hooks (see VirtualTap::gatewayFor4).
+    std::vector<VirtualTap::GatewayRoute4> gatewayRoutes;
+    for (unsigned int i = 0; i < n.config.routeCount; ++i) {
+        const InetAddress* target = reinterpret_cast<const InetAddress*>(&(n.config.routes[i].target));
+        const InetAddress* via = reinterpret_cast<const InetAddress*>(&(n.config.routes[i].via));
+        if (! target->isV4() || ! via->isV4()) {
+            continue;
+        }
+        unsigned int bits = target->netmaskBits();
+        if (bits > 32) {
+            continue;
+        }
+        VirtualTap::GatewayRoute4 route;
+        route.bits = bits;
+        route.mask = bits == 0 ? 0 : htonl(0xffffffffU << (32 - bits));
+        route.network = *reinterpret_cast<const uint32_t*>(target->rawIpData()) & route.mask;
+        route.via = *reinterpret_cast<const uint32_t*>(via->rawIpData());
+        gatewayRoutes.push_back(route);
+    }
+    n.tap->setGatewayRoutes4(gatewayRoutes);
 }
 
