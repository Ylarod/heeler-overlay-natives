+ZT_ResultCode Node::addLocalMoon(void *tptr,const void *moon,unsigned int len)
+{
+	if ((!moon)||(len == 0)||(len > ZT_WORLD_MAX_SERIALIZED_LENGTH)) {
+		return ZT_RESULT_ERROR_BAD_PARAMETER;
+	}
+	try {
+		World w;
+		const unsigned int used = w.deserialize(Buffer<ZT_WORLD_MAX_SERIALIZED_LENGTH>(moon,len),0);
+		if ((used != len)||(w.type() != World::TYPE_MOON)||(w.id() == 0)||(w.roots().empty())) {
+			return ZT_RESULT_ERROR_BAD_PARAMETER;
+		}
+		return RR->topology->addWorld(tptr,w,true) ? ZT_RESULT_OK : ZT_RESULT_ERROR_BAD_PARAMETER;
+	} catch ( ... ) {
+		return ZT_RESULT_ERROR_BAD_PARAMETER;
+	}
 }
 
