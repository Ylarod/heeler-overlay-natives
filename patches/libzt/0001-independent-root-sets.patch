+void Topology::_bestPerRootSet(int64_t now,const Address *sameSetAs,std::vector< SharedPtr<Peer> > &out)
+{
+	// assumes _peers_m and _upstreams_m are locked
+	std::vector< const std::vector<World::Root> * > sets;
+	sets.push_back(&(_planet.roots()));
+	for(std::vector<World>::const_iterator m(_moons.begin());m!=_moons.end();++m) {
+		sets.push_back(&(m->roots()));
+	}
+	for(std::vector< const std::vector<World::Root> * >::const_iterator s(sets.begin());s!=sets.end();++s) {
+		if (sameSetAs) {
+			bool inSet = false;
+			for(std::vector<World::Root>::const_iterator r((*s)->begin());r!=(*s)->end();++r) {
+				if (r->identity.address() == *sameSetAs) {
+					inSet = true;
+					break;
+				}
+			}
+			if (!inSet) {
+				continue;
+			}
+		}
+		unsigned int bestq = ~((unsigned int)0);
+		const SharedPtr<Peer> *best = (const SharedPtr<Peer> *)0;
+		for(std::vector<World::Root>::const_iterator r((*s)->begin());r!=(*s)->end();++r) {
+			if (r->identity == RR->identity) {
+				continue;
+			}
+			const SharedPtr<Peer> *p = _peers.get(r->identity.address());
+			if (p) {
+				const unsigned int q = (*p)->relayQuality(now);
+				if (q <= bestq) {
+					bestq = q;
+					best = p;
+				}
+			}
+		}
+		if ((best)&&(std::find(out.begin(),out.end(),*best) == out.end())) {
+			out.push_back(*best);
+		}
+	}
+}
+
+void Topology::getBestUpstreamPerRootSet(std::vector< SharedPtr<Peer> > &upstreams)
+{
+	const int64_t now = RR->node->now();
+	Mutex::Lock _l2(_peers_m);
+	Mutex::Lock _l1(_upstreams_m);
+	_bestPerRootSet(now,(const Address *)0,upstreams);
+}
+
+void Topology::getRelaysFor(const Address &dest,std::vector< SharedPtr<Peer> > &relays)
+{
+	const int64_t now = RR->node->now();
+	Mutex::Lock _l2(_peers_m);
+	Mutex::Lock _l1(_upstreams_m);
+	const _LearnedVia *lv = _learnedVia.get(dest);
+	if ((lv)&&(std::find(_upstreamAddresses.begin(),_upstreamAddresses.end(),lv->upstream) != _upstreamAddresses.end())) {
+		const SharedPtr<Peer> *p = _peers.get(lv->upstream);
+		if ((p)&&((*p)->relayQuality(now) != ~((unsigned int)0))) {
+			relays.push_back(*p);
+			return;
+		}
+	}
+	const bool destIsUpstream = (std::find(_upstreamAddresses.begin(),_upstreamAddresses.end(),dest) != _upstreamAddresses.end());
+	_bestPerRootSet(now,destIsUpstream ? &dest : (const Address *)0,relays);
+}
+
+void Topology::noteRelayedVia(const Address &peer,const SharedPtr<Path> &path,int64_t now)
+{
+	if (!path) {
+		return;
+	}
+	Mutex::Lock _l2(_peers_m);
+	Mutex::Lock _l1(_upstreams_m);
+	if (std::find(_upstreamAddresses.begin(),_upstreamAddresses.end(),peer) != _upstreamAddresses.end()) {
+		return;
+	}
+	for(std::vector<Address>::const_iterator a(_upstreamAddresses.begin());a!=_upstreamAddresses.end();++a) {
+		const SharedPtr<Peer> *p = _peers.get(*a);
+		if ((p)&&((*p)->hasActivePathTo(now,path->address()))) {
+			_LearnedVia &lv = _learnedVia[peer];
+			lv.upstream = *a;
+			lv.ts = now;
+			return;
+		}
+	}
+}
